                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="File" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.MarkRoyaltyFiledCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />

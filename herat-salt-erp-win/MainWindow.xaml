                                    <StackPanel>
                                        <TextBlock Text="Generator Diesel &amp; Equipment Repairs" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding RepairFuelExpensesText}" Style="{StaticResource MonoTextStyle}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="RECORD DAILY SITE EXPENSE (AUTO-POSTS DR EXPENSE / CR CASH OR BANK)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="7">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Category" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding NewExpCategory}" Style="{StaticResource SaaSComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Description" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewExpDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Payee / Vendor" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewExpPayee, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Amount (AFN)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewExpAmountAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Pay From (GL)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding ExpensePayAccounts}" SelectedItem="{Binding NewExpPayAccount}" Style="{StaticResource SaaSComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Receipt #" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewExpReceiptRef, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <Button Content="+ Record Expense" Command="{Binding RecordMineExpenseCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                                <DataGrid ItemsSource="{Binding MineExpenses}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Exp #" Binding="{Binding ExpenseCode}" Width="110" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" />
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="135" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                        <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="150" />
                                        <DataGridTextColumn Header="GL Acct" Binding="{Binding PaymentAccountCode}" Width="65" />
                                        <DataGridTextColumn Header="Amount (AFN)" Binding="{Binding AmountAfn, StringFormat=N0}" Width="105" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 16. GOVERNMENT OBLIGATIONS, TAXES & PUBLIC BUILD PROJECTS (MoMP / CSR) -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=GovObligations}">
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="32"
                                Visibility="{Binding CannotViewFinancials, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Access Restricted: Only Mine Owner or Finance Officer can manage Government Obligations &amp; CSR Build Projects."
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Visibility="{Binding CanViewFinancials, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[NavGovObligations]}" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Track all non-royalty government payments (Surface Rent, BRT Tax, NEPA Bond, Security) &amp; public CSR build commitments (Schools, Roads, Clinics, Water Wells)."
                                               Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Print Compliance Statement" Command="{Binding PrintGovObligationsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Committed / Budget" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GovTotalCommittedText}" Style="{StaticResource MonoTextStyle}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Paid / Spent to Date" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GovTotalPaidText}" Style="{StaticResource MonoTextStyle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Remaining Obligation" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GovTotalRemainingText}" Style="{StaticResource MonoTextStyle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Compliance Progress" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GovCompletedCountText}" Style="{StaticResource MonoTextStyle}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Add Custom Government Payment or Build Commitment -->
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ADD GOVERNMENT PAYMENT OR PUBLIC BUILD COMMITMENT" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="7">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Obligation / Project Title" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewGovTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Type" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding GovObligationTypes}" SelectedItem="{Binding NewGovType}" Style="{StaticResource SaaSComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Category" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding GovCategories}" SelectedItem="{Binding NewGovCategory}" Style="{StaticResource SaaSComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Ministry / Agency" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewGovMinistry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Budget / Due (AFN)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewGovBudgetAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Installment (AFN)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding GovInstallmentAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                        </StackPanel>
                                        <Button Content="+ Add Commitment" Command="{Binding AddGovObligationCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                                <DataGrid ItemsSource="{Binding GovernmentObligations}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding ObligationCode}" Width="75" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding ObligationType}" Width="110" />
                                        <DataGridTextColumn Header="Government Payment / Public Build Project" Binding="{Binding Title}" Width="*" />
                                        <DataGridTextColumn Header="Agency" Binding="{Binding MinistryOrAgency}" Width="140" />
                                        <DataGridTextColumn Header="Budget (AFN)" Binding="{Binding BudgetOrDueAfn, StringFormat=N0}" Width="95" />
                                        <DataGridTextColumn Header="Paid/Spent" Binding="{Binding PaidOrSpentAfn, StringFormat=N0}" Width="90" />
                                        <DataGridTextColumn Header="Done %" Binding="{Binding ProgressPct, StringFormat='{}{0:F0}%'}" Width="60" />
                                        <DataGridTemplateColumn Header="Actions (GL Auto-Post)" Width="185">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="+ Pay/Spend" Style="{StaticResource PrimaryButtonStyle}" Padding="6,3" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.PayGovObligationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Mark Done" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3"
                                                                Command="{Binding DataContext.CompleteGovObligationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- DPAPI OPERATOR LOGIN MODAL -->
        <Grid Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsLoginOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SurfaceCardStyle}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Windows DPAPI Operator Sign-In" FontSize="14" FontWeight="SemiBold" />
                        <Button Content="✕" Command="{Binding CloseLoginCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,3" />
                    </Grid>
                    <TextBlock Text="Operator Email (owner / ops / kanta / warehouse / finance / hse @heratsalt.af)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,0,14" />
                    <Button Content="Sign In &amp; Seal DPAPI Token" Command="{Binding SignInOperatorCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- SLIDE-OVER SCANNABLE QR WAYBILL DRAWER -->
        <Grid Grid.ColumnSpan="2" Background="#8C000000" Visibility="{Binding IsWaybillDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="410" HorizontalAlignment="Right" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderHairBrush}" BorderThickness="1,0,0,0" Padding="20">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Official QR Waybill / Bilty" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWaybill.TicketNumber}" Style="{StaticResource MonoTextStyle}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseWaybillCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,4" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="{Binding Strings[PrintWaybill]}" Command="{Binding PrintWaybillCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Close" Command="{Binding CloseWaybillCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <StackPanel>
                        <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image Source="{Binding SelectedWaybillQrImage}" Width="148" Height="148" Stretch="Uniform" />
                        </Border>
                        <Border Style="{StaticResource TerminalBoxStyle}" Margin="0,0,0,12" Padding="10">
                            <TextBlock Style="{StaticResource MonoTextStyle}" Foreground="#CBD5E1" FontSize="11" TextAlignment="Center">
                                <Run Text="SHA-256 SEAL: " /><Run Text="{Binding SelectedWaybill.QrPayloadHash}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding SelectedWaybill.TruckPlate, StringFormat='Truck Plate: {0}'}" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding SelectedWaybill.DriverName, StringFormat='Driver: {0}'}" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding SelectedWaybill.DriverTazkira, StringFormat='Tazkira ID: {0}'}" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding SelectedWaybill.CounterpartyName, StringFormat='Buyer: {0}'}" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding SelectedWaybill.DestinationType, StringFormat='Destination: {0}'}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedWaybill.GrossWeightKg, StringFormat='Gross: {0:N0} kg'}" Style="{StaticResource MonoTextStyle}" />
                                <TextBlock Text="{Binding SelectedWaybill.TareWeightKg, StringFormat='Tare:  {0:N0} kg'}" Style="{StaticResource MonoTextStyle}" Margin="0,4,0,4" />
                                <TextBlock Text="{Binding SelectedWaybill.NetWeightKg, StringFormat='NET:   {0:N0} kg'}" Style="{StaticResource MonoTextStyle}"
                                           Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="15" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- FLOATING TOAST -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20" Padding="14,9" CornerRadius="10"
                Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ToastMessage}" FontSize="12" FontWeight="Medium" />
        </Border>
    </Grid>
</Window>

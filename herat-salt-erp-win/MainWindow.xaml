<Window x:Class="HeratSaltErp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HeratSaltErp.Converters"
        Title="Herat Salt Mine ERP — Ghoryan &amp; Kuhsan Operations (Windows C#)"
        Width="1400" Height="880" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FlowDirection="{Binding WindowFlowDirection}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:TabVisibilityConverter x:Key="TabVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- AI BRIDGE UI SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderHairBrush}" BorderThickness="0,0,1,0" Padding="12,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,16">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="HS" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Strings[BrandTitle]}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Strings[BrandSub]}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- DPAPI Operator Login + Site Sync Link -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="{Binding OperatorBadge}" Command="{Binding OpenLoginCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" />

                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Site Sync Link" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10" />
                            <Border BorderBrush="{DynamicResource BorderHairBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding Strings[OfflineToggle]}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <CheckBox Style="{StaticResource SpringToggleStyle}"
                                              IsChecked="{Binding IsOfflineMode}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SCROLLABLE NAVIGATION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="OPERATIONS" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,6" />
                        <StackPanel Margin="0,0,0,12">
                            <RadioButton GroupName="Nav" IsChecked="True" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavDashboard]}" Command="{Binding SelectTabCommand}" CommandParameter="Dashboard" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavWeighbridge]}" Command="{Binding SelectTabCommand}" CommandParameter="Weighbridge" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavExtraction]}" Command="{Binding SelectTabCommand}" CommandParameter="Extraction" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavProcessing]}" Command="{Binding SelectTabCommand}" CommandParameter="Processing" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavQcLab]}" Command="{Binding SelectTabCommand}" CommandParameter="QcLab" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavStores]}" Command="{Binding SelectTabCommand}" CommandParameter="Stores" />
                        </StackPanel>

                        <TextBlock Text="COMMERCIAL &amp; EXPORTS" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,6" />
                        <StackPanel Margin="0,0,0,12">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavSales]}" Command="{Binding SelectTabCommand}" CommandParameter="Sales" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavCustomers]}" Command="{Binding SelectTabCommand}" CommandParameter="Customers" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavExports]}" Command="{Binding SelectTabCommand}" CommandParameter="Exports" />
                        </StackPanel>

                        <TextBlock Text="FINANCE &amp; GOVERNANCE" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,6" />
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavFinance]}" Command="{Binding SelectTabCommand}" CommandParameter="Finance" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavGovObligations]}" Command="{Binding SelectTabCommand}" CommandParameter="GovObligations" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavAccounting]}" Command="{Binding SelectTabCommand}" CommandParameter="Accounting" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavExpenses]}" Command="{Binding SelectTabCommand}" CommandParameter="Expenses" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavSuppliers]}" Command="{Binding SelectTabCommand}" CommandParameter="Suppliers" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavReports]}" Command="{Binding SelectTabCommand}" CommandParameter="Reports" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavHrHse]}" Command="{Binding SelectTabCommand}" CommandParameter="HrHse" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavAudit]}" Command="{Binding SelectTabCommand}" CommandParameter="Audit" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                         Content="{Binding Strings[NavSettings]}" Command="{Binding SelectTabCommand}" CommandParameter="Settings" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <DockPanel Grid.Column="1">
            <!-- Top Header -->
            <Border DockPanel.Dock="Top" Height="50" Padding="20,0"
                    Background="{DynamicResource BgMainBrush}"
                    BorderBrush="{DynamicResource BorderHairBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Strings[BrandTitle]}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveBreadcrumb}" FontSize="12" FontWeight="SemiBold" />
                        <Button Content="{Binding PendingSyncLabel}"
                                Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVis}}"
                                Command="{Binding SyncQueueCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0" Padding="10,4" FontSize="11" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="FX:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding UsdToAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Width="56" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AllRoles}" SelectedItem="{Binding ActiveRole}"
                                  Style="{StaticResource SaaSComboBoxStyle}" Width="168" Margin="0,0,8,0" />
                        <Button Content="AFN ؋" Command="{Binding SetCurrencyCommand}" CommandParameter="AFN" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" />
                        <Button Content="USD $" Command="{Binding SetCurrencyCommand}" CommandParameter="USD" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="EN" Command="{Binding SetLangCommand}" CommandParameter="EN" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" />
                        <Button Content="دری" Command="{Binding SetLangCommand}" CommandParameter="FA" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" />
                        <Button Content="پښتو" Command="{Binding SetLangCommand}" CommandParameter="PS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SCROLLABLE CONTENT -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                <Grid MaxWidth="1140">

                    <!-- 1. EXECUTIVE DASHBOARD -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Dashboard}">
                        <TextBlock Text="{Binding Strings[NavDashboard]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Ghoryan &amp; Kuhsan Salt Operations · MoMP Royalty &amp; Islam Qala / Torghundi Customs"
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,16" />

                        <UniformGrid Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiExtracted]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiExtractedText}" Style="{StaticResource MonoTextStyle}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding KpiFuelText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiProcessed]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiProcessedText}" Style="{StaticResource MonoTextStyle}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBlock Text="86.8% Yield (35–42 ppm I2)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiDispatched]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiDispatchedText}" Style="{StaticResource MonoTextStyle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,2" />
                                    <TextBlock Text="Digital Kanta Verified" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiRevenue]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiRevenueText}" Style="{StaticResource MonoTextStyle}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding KpiRoyaltyText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ACTIVE QUARRY &amp; BRINE PAN TARGETS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Zones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding NameEn}" FontSize="12.5" FontWeight="Medium" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MonoTextStyle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding TodayExtractedMt}" /><Run Text=" / " /><Run Text="{Binding DailyTargetMt}" /><Run Text=" MT (" /><Run Text="{Binding ProgressPct, Mode=OneWay}" /><Run Text="%)" />
                                                    </TextBlock>
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPct, Mode=OneWay}" Maximum="100" Style="{StaticResource QuotaProgressStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TerminalBoxStyle}">
                            <StackPanel>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#CBD5E1">
                                    <Run Text="[KANTA-GHR-01]" Foreground="#64748B" /><Run Text=" [ONLINE] " Foreground="#10B981" />
                                    <Run Text="Windows COM3 RS-232 Weighbridge Bridge ready · SHA-256 QR sealing active." />
                                </TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0">
                                    <Run Text="[DPAPI-VAULT]" Foreground="#64748B" /><Run Text=" [SEALED] " Foreground="#6366F1" />
                                    <Run Text="Offline store persisted in %LocalAppData%\HeratSaltErp\herat_salt_erp.db (ACID SQLite WAL)." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. WEIGHBRIDGE (KANTA) MODULE -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Weighbridge}">
                        <TextBlock Text="{Binding Strings[NavWeighbridge]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Anti-Fraud Lock: Weights immutable after issuance; Clerk requests void, Supervisor approves."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,14" />

                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Truck Plate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketPlate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Driver Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketDriver, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Driver Tazkira" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketTazkira, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Buyer / Supplier" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketBuyer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Salt Grade / SKU" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding SaltGrades}" SelectedItem="{Binding TicketSaltGrade}" Style="{StaticResource SaaSComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Destination / Border" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding TicketDestination}" Style="{StaticResource SaaSComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Settlement Method" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding TicketPaymentMethod}" Style="{StaticResource SaaSComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Hawala / Saraf Ref" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketHawalaRef, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Gross Weight (kg)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketGrossKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tare Weight (kg)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketTareKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Net Weight" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TicketNetKgPreview}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="2,6,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Rate (AFN / MT)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketPriceAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding Strings[CaptureScale]}" Command="{Binding CaptureScaleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="{Binding Strings[IssueTicket]}" Command="{Binding IssueTicketCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Search & Filter Chips + DataGrid -->
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <StackPanel>
                                <Grid Margin="12">
                                    <TextBox Text="{Binding TicketSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Width="260" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="All" Command="{Binding SetTicketFilterCommand}" CommandParameter="ALL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" />
                                        <Button Content="Active" Command="{Binding SetTicketFilterCommand}" CommandParameter="ACTIVE" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" />
                                        <Button Content="Void Pending" Command="{Binding SetTicketFilterCommand}" CommandParameter="VOID_PENDING" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" />
                                        <Button Content="Voided" Command="{Binding SetTicketFilterCommand}" CommandParameter="VOIDED" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid ItemsSource="{Binding FilteredTickets}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ticket #" Binding="{Binding TicketNumber}" Width="130" />
                                        <DataGridTextColumn Header="Plate" Binding="{Binding TruckPlate}" Width="90" />
                                        <DataGridTextColumn Header="Buyer" Binding="{Binding CounterpartyName}" Width="*" />
                                        <DataGridTextColumn Header="Dest" Binding="{Binding DestinationType}" Width="135" />
                                        <DataGridTextColumn Header="Net (kg)" Binding="{Binding NetWeightKg, StringFormat=N0}" Width="80" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                        <DataGridTemplateColumn Header="Actions" Width="255">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="QR" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.OpenWaybillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Req Void" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.RequestVoidCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <Button Content="Approve Void" Style="{StaticResource DangerButtonStyle}" Padding="7,3"
                                                                Command="{Binding DataContext.ApproveVoidCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. EXTRACTION & FLEET MAINTENANCE -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Extraction}">
                        <TextBlock Text="{Binding Strings[NavExtraction]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Shift extraction logs, diesel tracking &amp; 500-hr fleet preventive maintenance / breakdown downtime."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,14" />

                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                            <UniformGrid Columns="6">
                                <TextBox Text="{Binding ExtZone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding ExtShift}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding ExtractionMethods}" SelectedItem="{Binding ExtMethod}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,6,0" />
                                <TextBox Text="{Binding ExtLead, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                <TextBox Text="{Binding ExtTons, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                <Button Content="Log Extraction" Command="{Binding LogExtractionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </UniformGrid>
                        </Border>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,14">
                            <DataGrid ItemsSource="{Binding ExtractionLogs}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneCode}" Width="105" />
                                    <DataGridTextColumn Header="Shift" Binding="{Binding ShiftCode}" Width="110" />
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="165" />
                                    <DataGridTextColumn Header="Crew Lead" Binding="{Binding CrewLeadName}" Width="*" />
                                    <DataGridTextColumn Header="Tonnage (MT)" Binding="{Binding RawTonnageMt, StringFormat=N1}" Width="95" />
                                    <DataGridTextColumn Header="Diesel (L)" Binding="{Binding FuelUsedL}" Width="80" />
                                    <DataGridTextColumn Header="Sync" Binding="{Binding SyncState}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding FleetAssets}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asset" Binding="{Binding AssetCode}" Width="125" />
                                    <DataGridTextColumn Header="Machine" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Hrs / Service" Binding="{Binding EngineHours}" Width="90" />
                                    <DataGridTextColumn Header="Downtime" Binding="{Binding DowntimeHoursMonth, StringFormat={}{0}h}" Width="80" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105" />
                                    <DataGridTemplateColumn Header="Maintenance" Width="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="500h Service" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.CompleteFleetServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button Content="+2.5h Breakdown" Style="{StaticResource DangerButtonStyle}" Padding="7,3"
                                                            Command="{Binding DataContext.LogFleetBreakdownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 4. PROCESSING, IODIZATION & WAREHOUSE TRANSFERS -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Processing}">
                        <TextBlock Text="{Binding Strings[NavProcessing]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Log crushing/iodization batches, multi-warehouse stockpiles, and inter-warehouse transfers / shrinkage."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,14" />

                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                            <UniformGrid Columns="6">
                                <ComboBox ItemsSource="{Binding SaltGrades}" SelectedItem="{Binding ProcGrade}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding WarehouseCodes}" SelectedItem="{Binding ProcWarehouse}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,6,0" />

                            <!-- Financial Statements Summary KPIs -->
                            <UniformGrid Columns="5" Margin="0,0,0,12">
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GlTotalAssetsText}" Style="{StaticResource MonoTextStyle}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Liabilities + Equity" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GlTotalLiabEquityText}" Style="{StaticResource MonoTextStyle}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Revenue (P&amp;L)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GlRevenueText}" Style="{StaticResource MonoTextStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Expenses (P&amp;L)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GlExpensesText}" Style="{StaticResource MonoTextStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SurfaceCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Net Profit / Loss" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding GlNetProfitText}" Style="{StaticResource MonoTextStyle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Trial Balance Status Banner -->
                            <Border Style="{StaticResource TerminalBoxStyle}" Padding="12,9" Margin="0,0,0,14">

                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock FontSize="12">
                                                                    <Run Text="{Binding Code}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="  " /><Run Text="{Binding Name}" />
                                                                </TextBlock>
                                                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource MonoTextStyle}" FontSize="12"
                                                                           Text="{Binding BalanceAfn, StringFormat='{}{0:N0} ؋'}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

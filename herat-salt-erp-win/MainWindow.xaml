<Window x:Class="HeratSaltErp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HeratSaltErp.Converters"
        Title="Herat Salt Mine ERP — Ghoryan &amp; Kuhsan Operations (Windows C#)"
        Width="1360" Height="860" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FlowDirection="{Binding WindowFlowDirection}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:TabVisibilityConverter x:Key="TabVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- AI BRIDGE UI SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderHairBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <DockPanel LastChildFill="False">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,20">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="HS" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Strings[BrandTitle]}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Strings[BrandSub]}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Operations Section -->
                <TextBlock DockPanel.Dock="Top" Text="OPERATIONS" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,6" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <RadioButton GroupName="Nav" IsChecked="True" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavDashboard]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Dashboard" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavWeighbridge]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Weighbridge" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavExtraction]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Extraction" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavProcessing]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Processing" />
                </StackPanel>

                <!-- Finance & Governance Section -->
                <TextBlock DockPanel.Dock="Top" Text="FINANCE &amp; GOVERNANCE" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,6" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavFinance]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Finance" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavHrHse]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="HrHse" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavRadioStyle}"
                                 Content="{Binding Strings[NavAudit]}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Audit" />
                </StackPanel>

                <!-- Control Link Status Card (Bottom Dock) -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SurfaceCardStyle}" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Site Sync Link" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10" />
                        <Border BorderBrush="{DynamicResource BorderHairBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid>
                                <TextBlock Text="{Binding Strings[OfflineToggle]}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource SpringToggleStyle}"
                                          IsChecked="{Binding IsOfflineMode}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <DockPanel Grid.Column="1">
            <!-- Sticky Topbar with Breadcrumbs, RBAC Role, Currency, Language, Theme -->
            <Border DockPanel.Dock="Top" Height="50" Padding="20,0"
                    Background="{DynamicResource BgMainBrush}"
                    BorderBrush="{DynamicResource BorderHairBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Strings[BrandTitle]}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveBreadcrumb}" FontSize="12" FontWeight="SemiBold" />
                        <Button Content="{Binding PendingSyncLabel}"
                                Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVis}}"
                                Command="{Binding SyncQueueCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="14,0,0,0" Padding="10,4" FontSize="11" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding AllRoles}" SelectedItem="{Binding ActiveRole}"
                                  Style="{StaticResource SaaSComboBoxStyle}" Width="175" Margin="0,0,8,0" />
                        <Button Content="AFN ؋" Command="{Binding SetCurrencyCommand}" CommandParameter="AFN"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" />
                        <Button Content="USD $" Command="{Binding SetCurrencyCommand}" CommandParameter="USD"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="EN" Command="{Binding SetLangCommand}" CommandParameter="EN"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" />
                        <Button Content="دری" Command="{Binding SetLangCommand}" CommandParameter="FA"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" />
                        <Button Content="پښتو" Command="{Binding SetLangCommand}" CommandParameter="PS"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="Light / Dark" Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SCROLLABLE MODULE VIEWPORT -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                <Grid MaxWidth="1120">

                    <!-- 1. EXECUTIVE DASHBOARD -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Dashboard}">
                        <TextBlock Text="{Binding Strings[NavDashboard]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Ghoryan &amp; Kuhsan Salt Operations · MoMP &amp; Herat Customs Compliance (1 USD = 71.50 AFN)"
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,18" />

                        <!-- KPI Cards -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiExtracted]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiExtractedText}" Style="{StaticResource MonoTextStyle}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBlock Text="3 Active Quarry Zones" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiProcessed]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiProcessedText}" Style="{StaticResource MonoTextStyle}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBlock Text="86.8% Yield (35–42 ppm I2)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiDispatched]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiDispatchedText}" Style="{StaticResource MonoTextStyle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,2" />
                                    <TextBlock Text="Digital Kanta Verified" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[KpiRevenue]}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding KpiRevenueText}" Style="{StaticResource MonoTextStyle}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding KpiRoyaltyText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Zone Quota Cards -->
                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ACTIVE QUARRY &amp; BRINE PAN TARGETS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Zones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding NameEn}" FontSize="12.5" FontWeight="Medium" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MonoTextStyle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding TodayExtractedMt}" /><Run Text=" / " /><Run Text="{Binding DailyTargetMt}" /><Run Text=" MT (" /><Run Text="{Binding ProgressPct, Mode=OneWay}" /><Run Text="%)" />
                                                    </TextBlock>
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPct, Mode=OneWay}" Maximum="100" Style="{StaticResource QuotaProgressStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Obsidian Live Telemetry Terminal -->
                        <Border Style="{StaticResource TerminalBoxStyle}">
                            <StackPanel>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#CBD5E1">
                                    <Run Text="[KANTA-GHR-01]" Foreground="#64748B" />
                                    <Run Text=" [ONLINE] " Foreground="#10B981" />
                                    <Run Text="Native Windows COM3 RS-232 Weighbridge Bridge ready · SHA-256 QR sealing active." />
                                </TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,0">
                                    <Run Text="[DPAPI-VAULT]" Foreground="#64748B" />
                                    <Run Text=" [SEALED] " Foreground="#6366F1" />
                                    <Run Text="Offline local store persisted in %LocalAppData%\HeratSaltErp\erp_offline_store.json." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. WEIGHBRIDGE (KANTA) MODULE -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Weighbridge}">
                        <TextBlock Text="{Binding Strings[NavWeighbridge]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Anti-Fraud Lock: Weights are immutable after issuance; voiding requires supervisor approval."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,16" />

                        <!-- Ticket Entry Form -->
                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Truck Plate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketPlate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Driver Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketDriver, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Driver Tazkira" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketTazkira, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Buyer / Wholesaler" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketBuyer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Gross Weight (kg)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketGrossKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tare Weight (kg)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketTareKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Net Weight (Computed)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TicketNetKgPreview}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,6,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Rate (AFN / MT)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TicketPriceAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding Strings[CaptureScale]}" Command="{Binding CaptureScaleCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="{Binding Strings[IssueTicket]}" Command="{Binding IssueTicketCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tickets DataGrid -->
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding WeighbridgeTickets}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ticket #" Binding="{Binding TicketNumber}" Width="140" />
                                    <DataGridTextColumn Header="Plate" Binding="{Binding TruckPlate}" Width="100" />
                                    <DataGridTextColumn Header="Buyer" Binding="{Binding CounterpartyName}" Width="*" />
                                    <DataGridTextColumn Header="Net (kg)" Binding="{Binding NetWeightKg, StringFormat=N0}" Width="90" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105" />
                                    <DataGridTextColumn Header="Sync" Binding="{Binding SyncState}" Width="95" />
                                    <DataGridTemplateColumn Header="Actions" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="QR Drawer" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OpenWaybillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Approve Void" Style="{StaticResource DangerButtonStyle}" Padding="8,3"
                                                            Command="{Binding DataContext.ApproveVoidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 3. EXTRACTION & FLEET MAINTENANCE -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Extraction}">
                        <TextBlock Text="{Binding Strings[NavExtraction]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Ghoryan rock salt blasting, Kuhsan solar evaporation pans &amp; 500-hr fleet preventive maintenance."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,16" />

                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                            <UniformGrid Columns="5">
                                <TextBox Text="{Binding ExtZone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0" />
                                <TextBox Text="{Binding ExtLead, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0" />
                                <TextBox Text="{Binding ExtTons, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0" />
                                <TextBox Text="{Binding ExtFuel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0" />
                                <Button Content="Log Shift Tonnage" Command="{Binding LogExtractionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </UniformGrid>
                        </Border>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding ExtractionLogs}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneCode}" Width="110" />
                                    <DataGridTextColumn Header="Crew Lead" Binding="{Binding CrewLeadName}" Width="*" />
                                    <DataGridTextColumn Header="Equipment" Binding="{Binding EquipmentCode}" Width="130" />
                                    <DataGridTextColumn Header="Tonnage (MT)" Binding="{Binding RawTonnageMt, StringFormat=N1}" Width="110" />
                                    <DataGridTextColumn Header="Diesel (L)" Binding="{Binding FuelUsedL}" Width="90" />
                                    <DataGridTextColumn Header="Sync" Binding="{Binding SyncState}" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding FleetAssets}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asset" Binding="{Binding AssetCode}" Width="130" />
                                    <DataGridTextColumn Header="Machine" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Engine Hrs" Binding="{Binding EngineHours}" Width="95" />
                                    <DataGridTextColumn Header="Next Service" Binding="{Binding NextServiceHours}" Width="100" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                    <DataGridTemplateColumn Header="Maintenance" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Complete Service" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3"
                                                        Command="{Binding DataContext.CompleteFleetServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 4. PROCESSING & WAREHOUSE INVENTORY -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Processing}">
                        <TextBlock Text="{Binding Strings[NavProcessing]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Crushing, washing, 30–50 ppm food-grade iodization &amp; multi-warehouse stockpiles."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,16" />
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding WarehouseStocks}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseCode}" Width="125" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding WarehouseName}" Width="*" />
                                    <DataGridTextColumn Header="Salt Grade" Binding="{Binding SaltGrade}" Width="180" />
                                    <DataGridTextColumn Header="On-Hand (MT)" Binding="{Binding QuantityMt, StringFormat=N1}" Width="110" />
                                    <DataGridTextColumn Header="Capacity %" Binding="{Binding UtilizationPct, StringFormat={}{0}%}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding ProcessingBatches}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchCode}" Width="130" />
                                    <DataGridTextColumn Header="Grade" Binding="{Binding SaltGrade}" Width="*" />
                                    <DataGridTextColumn Header="Intake (MT)" Binding="{Binding IntakeMt}" Width="100" />
                                    <DataGridTextColumn Header="Output (MT)" Binding="{Binding OutputMt}" Width="100" />
                                    <DataGridTextColumn Header="Shrinkage" Binding="{Binding ShrinkageMt}" Width="90" />
                                    <DataGridTextColumn Header="Iodine Compliance" Binding="{Binding Compliance}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 5. FINANCE, HAWALA & MOMP ROYALTIES -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Finance}">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings[NavFinance]}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Dual-currency AFN/USD Hawala ledger &amp; MoMP / Herat Customs royalty filings."
                                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Content="{Binding Strings[ExportCsv]}" Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding FinancialLedger}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="165" />
                                    <DataGridTextColumn Header="Counterparty" Binding="{Binding Counterparty}" Width="*" />
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="115" />
                                    <DataGridTextColumn Header="Saraf / Bank Ref" Binding="{Binding Reference}" Width="190" />
                                    <DataGridTextColumn Header="AFN Equiv" Binding="{Binding AmountAfnEquiv, StringFormat=N0}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding MompRoyalties}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MoMP Period" Binding="{Binding PeriodLabel}" Width="*" />
                                    <DataGridTextColumn Header="Extracted (MT)" Binding="{Binding ExtractedMt}" Width="110" />
                                    <DataGridTextColumn Header="Border Ref" Binding="{Binding CustomsBorderRef}" Width="155" />
                                    <DataGridTextColumn Header="Royalty (AFN)" Binding="{Binding TotalRoyaltyAfn, StringFormat=N0}" Width="125" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                    <DataGridTemplateColumn Header="Action" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Mark Paid" Style="{StaticResource PrimaryButtonStyle}" Padding="8,3"
                                                        Command="{Binding DataContext.MarkRoyaltyPaidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 6. HR, PAYROLL & HSE -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=HrHse}">
                        <TextBlock Text="{Binding Strings[NavHrHse]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="AFN daily wages, per-ton extraction bonuses, and mine safety (HSE) compliance."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,16" />
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding PayrollRecords}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="115" />
                                    <DataGridTextColumn Header="Employee" Binding="{Binding FullName}" Width="*" />
                                    <DataGridTextColumn Header="Position" Binding="{Binding RoleTitle}" Width="190" />
                                    <DataGridTextColumn Header="Days" Binding="{Binding DaysWorked}" Width="65" />
                                    <DataGridTextColumn Header="Net Payable (AFN)" Binding="{Binding NetPayableAfn, StringFormat=N0}" Width="135" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding HseIncidents}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneCode}" Width="110" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding IncidentType}" Width="140" />
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 7. IMMUTABLE AUDIT LOG -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Audit}">
                        <TextBlock Text="{Binding Strings[NavAudit]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Append-only anti-fraud security trail for all weighbridge, finance, and offline sync events."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,16" />
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding AuditLogs}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="90" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="135" />
                                    <DataGridTextColumn Header="Record Ref" Binding="{Binding RecordRef}" Width="145" />
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="145" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- SLIDE-OVER QR WAYBILL INSPECTOR DRAWER -->
        <Grid Grid.ColumnSpan="2" Background="#8C000000"
              Visibility="{Binding IsWaybillDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="390" HorizontalAlignment="Right"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderHairBrush}"
                    BorderThickness="1,0,0,0" Padding="20">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Official QR Waybill / Bilty" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWaybill.TicketNumber}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseWaybillCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,4" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="{Binding Strings[PrintWaybill]}" Command="{Binding PrintWaybillCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Close" Command="{Binding CloseWaybillCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <StackPanel>
                        <Border Style="{StaticResource TerminalBoxStyle}" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource MonoTextStyle}" Foreground="#CBD5E1" FontSize="11" TextAlignment="Center">
                                <Run Text="SHA-256 SEAL: " /><Run Text="{Binding SelectedWaybill.QrPayloadHash}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding SelectedWaybill.TruckPlate, StringFormat='Truck Plate: {0}'}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedWaybill.DriverName, StringFormat='Driver: {0}'}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedWaybill.DriverTazkira, StringFormat='Tazkira ID: {0}'}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedWaybill.CounterpartyName, StringFormat='Buyer: {0}'}" Margin="0,0,0,14" />
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedWaybill.GrossWeightKg, StringFormat='Gross: {0:N0} kg'}" Style="{StaticResource MonoTextStyle}" />
                                <TextBlock Text="{Binding SelectedWaybill.TareWeightKg, StringFormat='Tare:  {0:N0} kg'}" Style="{StaticResource MonoTextStyle}" Margin="0,4,0,4" />
                                <TextBlock Text="{Binding SelectedWaybill.NetWeightKg, StringFormat='NET:   {0:N0} kg'}" Style="{StaticResource MonoTextStyle}"
                                           Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="15" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- FLOATING TOAST NOTIFICATION -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20" Padding="14,9" CornerRadius="10"
                Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ToastMessage}" FontSize="12" FontWeight="Medium" />
        </Border>
    </Grid>
</Window>

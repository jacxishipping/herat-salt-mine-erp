                                    <TextBlock Text="{Binding TrialBalanceCheckText}" Style="{StaticResource MonoTextStyle}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#10B981" />
                                    <TextBlock Text="{Binding BalanceSheetEquationText}" Style="{StaticResource MonoTextStyle}"
                                               FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- DEDICATED BALANCE SHEET (STATEMENT OF FINANCIAL POSITION) -->
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">

                                        <TextBlock Text="Salt Grade / SKU" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding SaltGrades}" SelectedItem="{Binding SaleSaltGrade}" Style="{StaticResource SaaSComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Destination / Freight" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />

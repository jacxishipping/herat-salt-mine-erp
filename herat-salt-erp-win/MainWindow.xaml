                                                <TextBlock Text="LIABILITIES" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding BalanceSheetLiabilities}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock FontSize="12">
                                                                    <Run Text="{Binding Code}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="  " /><Run Text="{Binding Name}" />

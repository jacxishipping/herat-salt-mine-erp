                        <StackPanel Visibility="{Binding CanViewFinancials, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Strings[NavAccounting]}" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Double-Entry General Ledger (DR = CR) · Auto-Posted from Sales, Kanta, Supplier AP &amp; MoMP Royalties · P&amp;L &amp; Balance Sheet"

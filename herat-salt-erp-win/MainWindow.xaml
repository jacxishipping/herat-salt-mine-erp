                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Mark Paid" Style="{StaticResource PrimaryButtonStyle}" Padding="7,3"
                                                        Command="{Binding DataContext.SettleInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 6. CUSTOMERS & CONTRACTS (CRM) -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Customers}">
                        <TextBlock Text="{Binding Strings[NavCustomers]}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Manage Herat wholesalers, food processors, government tenders, export buyers, credit limits &amp; tonnage contracts."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,4,0,14" />

                        <!-- Add Customer Form -->
                        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ADD CUSTOMER / OFFTAKER" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                                <UniformGrid Columns="4">
                                    <TextBox Text="{Binding NewCustName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding CustomerTypes}" SelectedItem="{Binding NewCustType}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding NewCustCreditAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,8,0" />
                                    <Button Content="+ Add Customer" Command="{Binding AddCustomerCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>


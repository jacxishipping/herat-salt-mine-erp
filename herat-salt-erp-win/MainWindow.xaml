                                                    <Grid>
                                                        <TextBlock Text="TOTAL ASSETS" FontSize="12.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding GlTotalAssetsText}" HorizontalAlignment="Right"
                                                                   Style="{StaticResource MonoTextStyle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DockPanel>
                                        </Border>


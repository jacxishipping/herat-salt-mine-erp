                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="5" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Quantity (MT)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SaleQtyMt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Target Margin %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SaleTargetMarginPct, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Auto Rate (AFN/MT)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SalePriceAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Hawala / Saraf Ref" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SaleHawalaRef, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Order Total" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SaleTotalPreview}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="15" Margin="2,4,0,0" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Live Cost-Plus Landed Breakdown -->
                                <Border Style="{StaticResource TerminalBoxStyle}" Margin="0,0,0,12" Padding="11">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SaleBreakdownSummary}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SaleProfitPreview}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#10B981" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Confirm Sale &amp; Generate Invoice" Command="{Binding CreateSaleOrderCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding Invoices}" Style="{StaticResource SaaSDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="125" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding TicketNumber}" Width="125" />
                                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />

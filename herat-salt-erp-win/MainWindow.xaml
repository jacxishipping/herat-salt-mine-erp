                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Long-Term Tonnage Contracts -->
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="LONG-TERM TONNAGE CONTRACTS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                                <UniformGrid Columns="5" Margin="0,0,0,12">
                                    <TextBox Text="{Binding NewCtrCustomer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding SaltGrades}" SelectedItem="{Binding NewCtrGrade}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding NewCtrMt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding NewCtrPriceAfn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <Button Content="+ Sign Contract" Command="{Binding AddContractCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </UniformGrid>
                                <DataGrid ItemsSource="{Binding Contracts}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Contract #" Binding="{Binding ContractCode}" Width="130" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                                        <DataGridTextColumn Header="Grade" Binding="{Binding SaltGrade}" Width="165" />
                                        <DataGridTextColumn Header="Delivered / Total MT" Binding="{Binding DeliveredMt}" Width="130" />
                                        <DataGridTextColumn Header="Rate AFN/MT" Binding="{Binding TierPriceAfnPerMt, StringFormat=N0}" Width="105" />
                                        <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPct, StringFormat={}{0}%}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. FINANCE, CONTRACTS, HAWALA & MOMP ROYALTIES -->
                    <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource TabVis}, ConverterParameter=Finance}">
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="32"
                                Visibility="{Binding CannotViewFinancials, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Access Restricted: Switch role to Mine Owner or Finance Officer to access Hawala ledgers, contracts, and MoMP royalties."
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <StackPanel Visibility="{Binding CanViewFinancials, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[NavFinance]}" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Hawala settlements, customer credit, long-term tonnage contracts, invoices &amp; MoMP royalties."
                                               Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="{Binding Strings[ExportCsv]}" Command="{Binding ExportCsvCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Post Hawala / Bank / Cash Entry -->
                            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,14">
                                <UniformGrid Columns="6">
                                    <TextBox Text="{Binding FinCounterparty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding FinAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding FinCurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding FinMethod}" Style="{StaticResource SaaSComboBoxStyle}" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding FinReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SaaSTextBoxStyle}" Margin="0,0,6,0" />
                                    <Button Content="Post Settlement" Command="{Binding PostFinancialEntryCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </UniformGrid>
                            </Border>

                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,14">
                                <DataGrid ItemsSource="{Binding FinancialLedger}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="155" />
                                        <DataGridTextColumn Header="Counterparty" Binding="{Binding Counterparty}" Width="*" />
                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="105" />
                                        <DataGridTextColumn Header="Saraf / Bank Ref" Binding="{Binding Reference}" Width="185" />
                                        <DataGridTextColumn Header="AFN Equiv" Binding="{Binding AmountAfnEquiv, StringFormat=N0}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" Margin="0,0,0,14">
                                <DataGrid ItemsSource="{Binding Invoices}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="125" />
                                        <DataGridTextColumn Header="Ticket #" Binding="{Binding TicketNumber}" Width="130" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                                        <DataGridTextColumn Header="Total AFN" Binding="{Binding TotalAfn, StringFormat=N0}" Width="95" />
                                        <DataGridTextColumn Header="Balance AFN" Binding="{Binding BalanceAfn, StringFormat=N0}" Width="95" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                        <DataGridTemplateColumn Header="Action" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Settle Balance" Style="{StaticResource PrimaryButtonStyle}" Padding="7,3"
                                                            Command="{Binding DataContext.SettleInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="0">
                                <DataGrid ItemsSource="{Binding MompRoyalties}" Style="{StaticResource SaaSDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MoMP Period" Binding="{Binding PeriodLabel}" Width="*" />
                                        <DataGridTextColumn Header="Extracted MT" Binding="{Binding ExtractedMt}" Width="100" />
                                        <DataGridTextColumn Header="Border Ref" Binding="{Binding CustomsBorderRef}" Width="145" />
                                        <DataGridTextColumn Header="Royalty AFN" Binding="{Binding TotalRoyaltyAfn, StringFormat=N0}" Width="115" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
                                        <DataGridTemplateColumn Header="Workflow" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>

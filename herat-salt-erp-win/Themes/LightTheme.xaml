<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AI Bridge UI — Refined Light Theme Tokens -->
    <Color x:Key="BgMainColor">#F4F6FA</Color>
    <Color x:Key="BgSidebarColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgElevatedColor">#EEF2F7</Color>
    <Color x:Key="BgInputColor">#F8FAFC</Color>
    <Color x:Key="BgTerminalColor">#0B0F1A</Color>
    <Color x:Key="ComboPopupBgColor">#FFFFFF</Color>

    <Color x:Key="BorderHairColor">#E2E8F0</Color>
    <Color x:Key="BorderHoverColor">#CBD5E1</Color>

    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <Color x:Key="NavActiveBgColor">#EEF2FF</Color>
    <Color x:Key="NavActiveTextColor">#3730A3</Color>

    <Color x:Key="AccentColor">#4F46E5</Color>
    <Color x:Key="AccentHoverColor">#4338CA</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="SuccessBgColor">#18059669</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningBgColor">#18D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerBgColor">#18DC2626</Color>

    <Color x:Key="RowAltColor">#F8FAFC</Color>
    <Color x:Key="RowHoverColor">#EEF2FF</Color>
    <Color x:Key="RowSelectedColor">#E0E7FF</Color>
    <Color x:Key="ScrollThumbColor">#CBD5E1</Color>
    <Color x:Key="ScrollThumbHoverColor">#94A3B8</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgTerminalBrush" Color="{StaticResource BgTerminalColor}" />
    <SolidColorBrush x:Key="ComboPopupBgBrush" Color="{StaticResource ComboPopupBgColor}" />
    <SolidColorBrush x:Key="BorderHairBrush" Color="{StaticResource BorderHairColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="{StaticResource NavActiveBgColor}" />
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="{StaticResource NavActiveTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
</ResourceDictionary>
